# The learning app itself needs NO environment variables: all data lives in the browser (IndexedDB).
# The variables below are only used by the optional AI tutor adapter (src/app/api/tutor/route.ts).
# They are read on the server and never exposed to the browser.

# Local AI via Ollama (works when the app runs on the same machine as Ollama; not on Vercel)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional OpenAI-compatible provider (messages are sent to this provider when the user selects "External API")
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
